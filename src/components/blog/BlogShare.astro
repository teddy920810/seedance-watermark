---
interface Props {
  articleTitle: string;
  articleUrl: URL | string;
  shareLabel: string;
  copyLabel: string;
  copiedLabel: string;
}

const { articleTitle, articleUrl, shareLabel, copyLabel, copiedLabel } = Astro.props;
const url = articleUrl.toString();
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(articleTitle);
---

<div class="blog-share" aria-label={shareLabel}>
  <span>{shareLabel}</span>
  <div class="blog-share-links">
    <a href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`} target="_blank" rel="nofollow noopener noreferrer" aria-label="Share on X">X</a>
    <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`} target="_blank" rel="nofollow noopener noreferrer" aria-label="Share on LinkedIn">LinkedIn</a>
    <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`} target="_blank" rel="nofollow noopener noreferrer" aria-label="Share on Facebook">Facebook</a>
    <button type="button" data-blog-copy data-url={url} data-copy-label={copyLabel} data-copied-label={copiedLabel} aria-live="polite">{copyLabel}</button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-blog-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      const url = button.dataset.url ?? window.location.href;
      try {
        await navigator.clipboard.writeText(url);
        button.textContent = button.dataset.copiedLabel ?? 'Copied';
        window.setTimeout(() => { button.textContent = button.dataset.copyLabel ?? 'Copy link'; }, 1800);
      } catch {
        button.textContent = button.dataset.copyLabel ?? 'Copy link';
      }
    });
  });
</script>
