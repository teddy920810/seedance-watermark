---
import ImageUploader from './uploader/ImageUploader';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { splitFeatureCopy } from '../lib/content/feature-copy';
import { isCompleteFaq, isCompleteFeature, isCompleteStep, visibleItems } from '../lib/content/item-visibility';
import { publicAssetAvailable } from '../lib/content/public-asset';
import { resolveFeatureModule } from '../lib/content/feature-module';

interface Props { page: CollectionEntry<'landingPages'>['data'] }
const { page } = Astro.props;
const [siteEntries, homepageEntries] = await Promise.all([
  getCollection('siteSettings'),
  getCollection('homepage'),
]);
const [siteEntry] = siteEntries;
if (!siteEntry) throw new Error('Site settings CMS content is missing.');
const [homepageEntry] = homepageEntries;
if (!homepageEntry) throw new Error('Homepage CMS content is missing.');
const site = siteEntry.data;
const features = resolveFeatureModule(homepageEntry.data.features, page.features, page.featuresSource);
const featureItems = visibleItems(features.items, isCompleteFeature).map((item) => ({
  ...item,
  copy: splitFeatureCopy(item.description, item.listItems),
  showImage: publicAssetAvailable(item.image),
}));
const visibleFaqItems = visibleItems(page.faq.items, isCompleteFaq);
const processSteps = visibleItems(page.process.steps, isCompleteStep);
const faqSchema = visibleFaqItems.length > 0 ? {
  '@type': 'FAQPage',
  mainEntity: visibleFaqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
} : undefined;
---

<SiteLayout title={page.title} description={page.description} schema={faqSchema} variant="marketing">
  <section class="product-hero">
    <div class="hero-copy">
      <span class="eyebrow">{page.eyebrow}</span>
      <h1>{page.heading}</h1>
      <p>{page.intro}</p>
      <ul class="check-list">{page.benefits.map((benefit) => <li>{benefit}</li>)}</ul>
    </div>
    <div id="tool" class="product-workspace"><ImageUploader logo={site.logo} siteName={site.name} copy={site.uploader} client:load /></div>
  </section>

  <section class="product-how" id="how-it-works">
    <div class="section-heading"><span class="eyebrow">{page.process.eyebrow}</span><h2>{page.process.heading}</h2></div>
    <div class="steps">
      {processSteps.map((step) => <article><span>{step.number}</span><h3>{step.title}</h3><p>{step.description}</p></article>)}
    </div>
  </section>

  {featureItems.length ? (
    <section class="section features-section landing-features-section" aria-labelledby="features-heading">
      <div class="section-heading"><span class="eyebrow">{features.eyebrow}</span><h2 id="features-heading">{features.heading}</h2><p>{features.intro}</p></div>
      <div class="feature-list">
        {featureItems.map((item) => <article class:list={{ 'feature-item': true, 'is-image-left': item.imagePosition === 'left' }}>
          <div class="feature-copy"><span class="eyebrow">{item.eyebrow}</span><h3>{item.heading}</h3><p>{item.copy.description}</p>{item.copy.listItems.length > 0 && <ul class="feature-list-items">{item.copy.listItems.map((listItem) => <li>{listItem}</li>)}</ul>}</div>
          {item.showImage && <div class="feature-media"><img src={item.image} alt={item.imageAlt} loading="lazy" /></div>}
        </article>)}
      </div>
    </section>
  ) : null}

  {visibleFaqItems.length > 0 && <section class="section faq-section product-faq">
    <div class="section-heading"><span class="eyebrow">{page.faq.eyebrow}</span><h2>{page.faq.heading}</h2></div>
    <div class="faq-list">{visibleFaqItems.map((item) => <details><summary>{item.question}<span>+</span></summary><p>{item.answer}</p></details>)}</div>
  </section>}
  <section class="final-cta">
    <h2>{page.finalCta.heading || page.heading}</h2>
    <a class="marketing-button" href="#tool">{page.finalCta.label || 'Start now'} <span aria-hidden="true">→</span></a>
  </section>
</SiteLayout>
