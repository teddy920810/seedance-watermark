---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { visibleItems } from '../lib/content/item-visibility';
import { isUsableEditorialHref } from '../lib/content/site-settings';
import { publicAssetAvailable } from '../lib/content/public-asset';
import ResponsiveImage from '../components/ResponsiveImage.astro';

export const prerender = true;
const [homepage] = await getCollection('homepage');
if (!homepage) throw new Error('Homepage CMS content is missing.');
const home = homepage.data;
const [allBlogPosts, landingPages] = await Promise.all([getCollection('blog'), getCollection('landingPages')]);
const publicRoutes = new Set([
  '/', '/blog', '/privacy', '/terms',
  ...landingPages.map(({ data }) => `/${data.slug}`),
  ...allBlogPosts.map(({ data }) => `/blog/${data.slug}`),
]);
const useCases = visibleItems(home.useCases, (item) => Boolean(item.title.trim() && item.description.trim())).map((item) => ({
  ...item,
  usableHref: item.href.trim() !== '#' && isUsableEditorialHref(item.href, publicRoutes) ? item.href : '',
  showImage: publicAssetAvailable(item.image),
}));
const workflowItems = visibleItems(home.workflows.items, (item) => Boolean(item.label.trim() && item.title.trim())).map((item) => ({
  ...item,
  showImage: publicAssetAvailable(item.image),
}));
const heroCtaHref = isUsableEditorialHref(home.hero.ctaHref, publicRoutes) ? home.hero.ctaHref : '#tools';
const showHeroImage = publicAssetAvailable(home.hero.image);
---

<SiteLayout title={home.title} description={home.description} image={home.shareImage} variant="marketing" structuredDataType="WebSite">
  <section class="home-hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="hero-copy">
      <span class="eyebrow">{home.hero.eyebrow}</span>
      <h1>{home.hero.heading}<br /><em>{home.hero.highlightedHeading}</em></h1>
      <p>{home.hero.intro}</p>
      {home.hero.ctaLabel && <a class="marketing-button" href={heroCtaHref}>{home.hero.ctaLabel}<span aria-hidden="true">→</span></a>}
      <div class="trust-row">{home.hero.trustItems.map((item) => <span>{item}</span>)}</div>
    </div>
    {showHeroImage && <div class="home-hero-visual"><ResponsiveImage src={home.hero.image} alt={home.hero.imageAlt} fetchpriority="high" sizes="(max-width: 900px) 100vw, 50vw" /><span>{home.hero.imageBadge}</span></div>}
  </section>

  <section class="home-tools" id="tools" aria-labelledby="tools-heading">
    <div class="marketing-heading"><span class="eyebrow">{home.tools.eyebrow}</span><h2 id="tools-heading">{home.tools.heading}</h2><p>{home.tools.intro}</p></div>
    <div class="tool-showcase-grid">
      {useCases.map((item) => <article>
        {item.showImage && <div class="tool-showcase-media"><ResponsiveImage src={item.image} alt={item.imageAlt} loading="lazy" sizes="(max-width: 760px) 100vw, 33vw" /><span>{item.badge || item.icon}</span></div>}
        <div class="tool-showcase-copy"><h3>{item.title}</h3><p>{item.description}</p>{item.usableHref ? <a href={item.usableHref}>{item.linkLabel || 'Explore tool'} <span aria-hidden="true">→</span></a> : <span class="tool-coming-soon">Coming soon</span>}</div>
      </article>)}
    </div>
  </section>

  <section class="home-why" aria-labelledby="why-heading">
    <div><span class="eyebrow">{home.why.eyebrow}</span><h2 id="why-heading">{home.why.heading}</h2></div>
    <div class="home-why-items">{home.why.items.map((item) => <article><b>{item.number}</b><h3>{item.title}</h3><p>{item.description}</p></article>)}</div>
  </section>

  <section class="home-testimonials" aria-label="Creator testimonials">
    <div><span>{home.testimonials.rating}</span><blockquote>{home.testimonials.primary.quote}</blockquote><b>{home.testimonials.primary.name}</b><small>{home.testimonials.primary.role}</small></div>
    <aside><p>{home.testimonials.secondary.quote}</p><b>{home.testimonials.secondary.name}</b><small>{home.testimonials.secondary.role}</small></aside>
  </section>

  <section class="home-workflows" aria-labelledby="workflows-heading">
    <div class="marketing-heading"><span class="eyebrow">{home.workflows.eyebrow}</span><h2 id="workflows-heading">{home.workflows.heading}</h2></div>
    <div class="home-workflow-grid">{workflowItems.map((item) => <article>
      {item.showImage && <ResponsiveImage src={item.image} alt={item.imageAlt} loading="lazy" sizes="(max-width: 620px) 100vw, (max-width: 900px) 50vw, 25vw" />}
      <div><span>{item.label}</span><h3>{item.title}</h3></div>
    </article>)}</div>
  </section>
</SiteLayout>
