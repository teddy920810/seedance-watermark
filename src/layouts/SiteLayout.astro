---
import '../styles/global.css';
import AuthControls from '../components/auth/AuthControls';
import { getCollection } from 'astro:content';
import { usableHeaderNavigation } from '../lib/content/site-settings';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
  variant?: 'marketing' | 'editorial';
  structuredDataType?: 'WebSite' | 'WebApplication';
}

const [siteEntry] = await getCollection('siteSettings');
if (!siteEntry) throw new Error('Site settings CMS content is missing.');
const site = siteEntry.data;
const [landingPages, blogPosts] = await Promise.all([
  getCollection('landingPages'),
  getCollection('blog'),
]);
const publicRoutes = new Set([
  '/', '/blog', '/privacy', '/terms',
  ...landingPages.map(({ data }) => `/${data.slug}`),
  ...blogPosts.map(({ data }) => `/blog/${data.slug}`),
]);
const headerNavigation = usableHeaderNavigation(site.header.navigation, publicRoutes);

const {
  title = site.defaultTitle,
  description = site.defaultDescription,
  image = site.defaultShareImage,
  type = 'website',
  schema,
  noindex = false,
  variant = 'editorial',
  structuredDataType = variant === 'marketing' ? 'WebApplication' : 'WebSite',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const analyticsId = site.analytics.googleMeasurementId;
const defaultSchema = {
  '@type': structuredDataType,
  name: site.name,
  url: canonical.toString(),
  description,
  ...(structuredDataType === 'WebApplication' ? {
    applicationCategory: site.structuredData.applicationCategory,
    operatingSystem: site.structuredData.operatingSystem,
    offers: {
      '@type': 'Offer',
      price: site.structuredData.price,
      priceCurrency: site.structuredData.priceCurrency,
    },
  } : {}),
};
const schemas = [defaultSchema, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {analyticsId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}></script>}
    {analyticsId && <script is:inline define:vars={{ analyticsId }}>
      window.dataLayer = window.dataLayer || [];
      // Keep Google's official command-queue shape; gtag.js expects the arguments object.
      // eslint-disable-next-line prefer-rest-params
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', analyticsId);
    </script>}
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="theme-color" content={site.themeColor} />
    <link rel="icon" href={site.favicon} />
    {schemas.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...item })} />)}
  </head>
  <body class={`page-${variant}`} style={`--theme-color: ${site.themeColor}; --theme-color-fallback: ${site.themeColorFallback};`}>
    {site.announcement.enabled && (
      <aside class="site-announcement" aria-label="Site announcement">
        <span>{site.announcement.text}</span>
        {site.announcement.linkLabel && site.announcement.linkHref && <a href={site.announcement.linkHref}>{site.announcement.linkLabel} →</a>}
      </aside>
    )}
    <header class="site-header">
      <a class="brand" href="/" aria-label={`${site.name} home`}><img class="brand-logo" src={site.header.logo} alt="" /></a>
      <button class="mobile-menu-toggle" type="button" aria-label="Open navigation" aria-controls="site-navigation" aria-expanded="false" data-mobile-menu-toggle>
        <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
      </button>
      <nav id="site-navigation" aria-label="Main navigation">
        {headerNavigation.map((item, index) => (item.children?.length ?? 0) > 0 ? (
          <div class="nav-dropdown">
            <button class="nav-dropdown-trigger" type="button" aria-haspopup="true" aria-expanded="false" aria-controls={`nav-dropdown-${index}`} data-nav-dropdown-trigger>{item.label}<span aria-hidden="true">⌄</span></button>
            <div class="nav-dropdown-panel" id={`nav-dropdown-${index}`}>
              {(item.children ?? []).map((child) => <a href={child.href}>{child.label}</a>)}
            </div>
          </div>
        ) : <a href={item.href}>{item.label}</a>)}
      </nav>
      <AuthControls loginLabel={site.header.loginLabel} connectingLabel={site.header.connectingLabel} client:load />
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="footer-brand"><a class="brand" href="/" aria-label={`${site.name} home`}><img class="brand-logo" src={site.footer.logo} alt="" /></a><p>{site.footer.tagline}</p></div>
      {site.footer.groups.map((group) => (
        <div class="footer-group"><b>{group.label}</b>{group.links.map((item) => <a href={item.href}>{item.label}</a>)}</div>
      ))}
      <small>{site.footer.copyright}</small>
    </footer>
    <script>
      const header = document.querySelector<HTMLElement>('.site-header');
      const menuToggle = document.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]');
      const dropdownTriggers = document.querySelectorAll<HTMLButtonElement>('[data-nav-dropdown-trigger]');

      const closeDropdowns = () => dropdownTriggers.forEach((trigger) => {
        trigger.setAttribute('aria-expanded', 'false');
        trigger.closest('.nav-dropdown')?.classList.remove('is-open');
      });
      const closeMenu = () => {
        header?.classList.remove('is-menu-open');
        menuToggle?.setAttribute('aria-expanded', 'false');
        menuToggle?.setAttribute('aria-label', 'Open navigation');
        closeDropdowns();
      };

      menuToggle?.addEventListener('click', () => {
        const open = !header?.classList.contains('is-menu-open');
        header?.classList.toggle('is-menu-open', open);
        menuToggle.setAttribute('aria-expanded', String(open));
        menuToggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
        if (!open) closeDropdowns();
      });

      dropdownTriggers.forEach((trigger) => trigger.addEventListener('click', () => {
        const dropdown = trigger.closest('.nav-dropdown');
        const open = trigger.getAttribute('aria-expanded') !== 'true';
        closeDropdowns();
        trigger.setAttribute('aria-expanded', String(open));
        dropdown?.classList.toggle('is-open', open);
      }));

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeMenu();
          menuToggle?.focus();
        }
      });
      document.addEventListener('click', (event) => {
        if (header && event.target instanceof Node && !header.contains(event.target)) closeMenu();
      });
    </script>
  </body>
</html>

